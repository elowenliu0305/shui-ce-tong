# Browser-visible configuration only. Never put service-role or model keys here.
VITE_DATA_BACKEND=mock
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only names are documented as empty placeholders so configuration can be
# validated without committing values. Set them with Supabase secrets or an
# ignored local worker environment file.
SUPABASE_SERVICE_ROLE_KEY=
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
