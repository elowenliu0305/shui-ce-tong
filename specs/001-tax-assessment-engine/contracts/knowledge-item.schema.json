{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuicetong.local/schemas/knowledge-document-v2.json",
  "title": "KnowledgeDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "sourceIds",
    "title",
    "docNo",
    "issuer",
    "publishedAt",
    "effectiveStatus",
    "parseStatus",
    "fullText",
    "summary",
    "downloadRefs",
    "matchEligibility",
    "reviewStatus",
    "recordVersion"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["policy", "news", "case", "other"] },
    "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "title": { "type": "string", "minLength": 1 },
    "docNo": { "type": ["string", "null"] },
    "issuer": { "type": "array", "items": { "type": "string" } },
    "publishedAt": { "type": ["string", "null"], "format": "date" },
    "effectiveFrom": { "type": ["string", "null"], "format": "date" },
    "effectiveTo": { "type": ["string", "null"], "format": "date" },
    "effectiveStatus": { "enum": ["effective", "expired", "repealed", "partial", "unknown"] },
    "parseStatus": { "enum": ["parsed", "partial", "failed"] },
    "fullText": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "regions": { "type": "array", "items": { "type": "string" } },
    "industries": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "downloadRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "matchEligibility": { "enum": ["structured-verified", "searchable-only"] },
    "reviewStatus": { "enum": ["pending", "extracted", "needs-review", "approved", "rejected", "superseded"] },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "supersededBy": { "type": "array", "items": { "type": "string" } },
    "sourceFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "sourceId", "locator", "reviewed"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "sourceId": { "type": "string" },
          "locator": { "type": ["string", "null"] },
          "reviewed": { "type": "boolean" }
        }
      }
    },
    "recordVersion": { "type": "string", "minLength": 1 }
  }
}
